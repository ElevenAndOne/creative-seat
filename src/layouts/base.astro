---
import '@fontsource-variable/golos-text/index.css'
import '@fontsource/instrument-serif/400.css'
import '@fontsource/instrument-serif/400-italic.css'
import '../index.css'
import CookieBanner from '../components/cookie-banner'

interface Props {
  title: string
  description: string
  /** Social share image, relative to the site root. */
  image?: string
  imageAlt?: string
}

const {
  title,
  description,
  image = '/og-image.jpg',
  imageAlt = 'Creative Seat — Increase your brand’s creative capability, beside a fan of client work',
} = Astro.props

// Absolute URLs from `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href
const imageUrl = new URL(image, Astro.site).href
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Consent + click tracking for Google Tag Manager — `is:inline` keeps Astro from bundling these as modules -->
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      // Consent commands only: GTM reads these in the gtag() form.
      // eslint-disable-next-line prefer-rest-params -- GTM reads the Arguments object; an array breaks it
      function gtag() { dataLayer.push(arguments) }
      // Consent Mode v2: no analytics or ad cookies until the visitor accepts in
      // the cookie banner (components/cookie-banner.tsx) — or already did.
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 })
      try {
        if (localStorage.getItem('cs-consent') === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' })
      } catch {
        // Storage blocked — stay denied.
      }

      // Click tracking: any element with data-track="<event>" pushes that event
      // to the data layer for GTM, tagged with its id and an optional
      // data-track-location. One delegated listener covers the static sections
      // as well as the islands.
      document.addEventListener('click', (e) => {
        const el = e.target instanceof Element ? e.target.closest('[data-track]') : null
        if (!el) return
        dataLayer.push({
          event: el.getAttribute('data-track'),
          element_id: el.id || undefined,
          location: el.getAttribute('data-track-location') || undefined,
          link_url: el.getAttribute('href') || undefined,
          link_text: (el.textContent || '').trim().slice(0, 100) || el.getAttribute('aria-label') || undefined,
        })
      })
    </script>
    <!-- Google Tag Manager — after the consent defaults above, so its tags start denied too. -->
    <script is:inline>/* eslint-disable no-var -- Google's snippet, kept verbatim */(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MQZ5TSC5');</script>
    <!-- Book a demo: keep the campaign a visitor landed with (utm_* in the URL) for the booking form to send on (utils/booking.ts). -->
    <script is:inline>
      try {
        const utm = [...new URLSearchParams(location.search)].filter(([key]) => key.startsWith('utm_'))
        if (utm.length) sessionStorage.setItem('cs-utm', JSON.stringify(Object.fromEntries(utm)))
      } catch {
        // Storage blocked: the form still reads the booking page's own URL.
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Icons: the brand's chair logomark, Ink on Volt. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#14121a" />

    <!-- Social cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Creative Seat" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Page-specific additions, e.g. structured data. -->
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MQZ5TSC5" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <slot />
    <CookieBanner client:idle />
  </body>
</html>
