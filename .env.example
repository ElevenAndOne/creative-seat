# Book a demo — copy to .env for local development, and add the same values in
# Vercel → Project Settings → Environment Variables.

# Where requests are kept: Vercel Blob. Create a Blob store in the Vercel
# project (Storage → Create → Blob, private) and connect it; Vercel adds this
# token to the deployment by itself. Copy it here for local testing. Without it
# (and without Google below), production refuses bookings rather than lose them,
# and `npm run dev` answers with sample bookings that aren't saved.
BLOB_READ_WRITE_TOKEN=

# ---- Google Calendar (optional, for later) ----------------------------------
# Until these are set, every slot in BOOKING_HOURS is open (less any already
# requested), and no calendar invite goes out — the team follows up by hand.

# A Google Cloud service account with the Google Calendar API enabled. Paste the
# key's `private_key` as one line with literal \n line breaks.
GOOGLE_CLIENT_EMAIL=demo-bookings@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Recommended (Google Workspace): act as the person whose calendar takes the
# demos, so bookings arrive as real invites with a Google Meet link sent to the
# visitor. Needs domain-wide delegation for the service account's client ID with
# these scopes:
#   https://www.googleapis.com/auth/calendar.events,https://www.googleapis.com/auth/calendar.freebusy
# Leave it unset to write to a calendar shared with the service account instead
# ("Make changes to events"); events then carry the visitor's details but no
# invite or Meet link.
GOOGLE_IMPERSONATE=demos@yourdomain.com

# The calendar bookings go into, and whose busy times block slots. `primary` is
# the impersonated person's own calendar.
GOOGLE_CALENDAR_ID=primary

# Optional: more calendars whose busy times should block slots, comma-separated
# (e.g. the rest of the team's).
# GOOGLE_BUSY_CALENDAR_IDS=alex@yourdomain.com,studio@yourdomain.com

# When demos can happen, in the studio's time zone. Visitors see the slots in
# their own. Weekends are always closed; to close a weekday (a public holiday),
# add an all-day event marked Busy to the calendar.
BOOKING_TIME_ZONE=Africa/Johannesburg
BOOKING_HOURS=09:00-17:00
# Breathing room kept clear either side of existing meetings.
BOOKING_BUFFER_MINUTES=0
